PROXMOX_HOST=https://your-proxmox-host-1:8006
PROXMOX_TOKEN_ID=root@pam!patchscanner
PROXMOX_TOKEN_SECRET=PASTE_SECRET_HERE

# Optional second Proxmox host (for multi-node / NF-02 verification)
PROXMOX_HOST_2=https://your-proxmox-host-2:8006
PROXMOX_TOKEN_ID_2=root@pam!scanner
PROXMOX_TOKEN_SECRET_2=PASTE_SECRET_HERE

VERIFY_SSL=false
OUTPUT_DIR=reports
TIMEOUT_SECONDS=20

# Elasticsearch / Kibana (optional — set ELASTICSEARCH_ENABLED=true to push reports)
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PREFIX=patchscanner

# Assignment report metadata
PROJECT_NAME=ProxWatch
REPORT_TYPE=patch_level_report
ENVIRONMENT=test_lab
SCANNER_VERSION=1.0.0

# Kibana dashboard automation (used by scripts/scan_and_analyze.sh)
# Use http:// — local Docker Kibana does not serve HTTPS
KIBANA_URL=http://localhost:5601
KIBANA_DASHBOARD_ID=ps-dashboard-main
EXPECTED_NODES=2
OPEN_BROWSER=true